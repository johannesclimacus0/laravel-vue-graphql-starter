{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "npm run graphql:generate && vp build",
        "dev": "npm run graphql:generate && vp dev",
        "check": "npm run graphql:generate && vp check",
        "check:fix": "npm run graphql:generate && vp check --fix",
        "types:check": "npm run graphql:generate && php artisan wayfinder:generate && vue-tsc --noEmit",
        "test": "npm run graphql:generate && vp test",
        "test:watch": "npm run graphql:generate && vp test --watch",
        "graphql:schema": "node scripts/export-graphql-schema.mjs",
        "graphql:generate": "npm run graphql:schema && graphql-codegen --config codegen.ts",
        "graphql:check": "php artisan lighthouse:validate-schema && npm run graphql:generate"
    },
    "dependencies": {
        "@tailwindcss/vite": "^4.1.11",
        "@vitejs/plugin-vue": "^6.0.0",
        "axios": "^1.20.0",
        "concurrently": "^10.0.3",
        "laravel-vite-plugin": "^3.1",
        "pinia": "^4.0.3",
        "tailwindcss": "^4.1.1",
        "typescript": "^5.2.2",
        "vue": "^3.5.13",
        "vue-router": "^5.3.1"
    },
    "devDependencies": {
        "@graphql-codegen/cli": "^8.0.0",
        "@graphql-codegen/client-preset": "^7.0.0",
        "@graphql-typed-document-node/core": "^3.2.0",
        "@laravel/echo-vue": "^2.6.1",
        "@laravel/vite-plugin-wayfinder": "^0.1.10",
        "@types/node": "^22.13.5",
        "@vue/test-utils": "^2.5.1",
        "graphql": "^17.1.0",
        "jsdom": "^29.1.1",
        "laravel-echo": "^2.6.1",
        "pusher-js": "^8.6.0",
        "vite-plus": "1.7.0",
        "vue-tsc": "^3.3.14"
    },
    "optionalDependencies": {
        "@laravel/multiplex": "^0.4.1",
        "@rollup/rollup-linux-x64-gnu": "4.9.5",
        "@tailwindcss/oxide-linux-x64-gnu": "^4.3.5",
        "lightningcss-linux-x64-gnu": "^1.29.1"
    },
    "overrides": {
        "shell-quote": "1.12.0",
        "vite": "npm:@voidzero-dev/vite-plus-core@8.3.8000"
    }
}
